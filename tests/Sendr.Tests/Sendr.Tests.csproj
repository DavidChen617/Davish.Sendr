<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Features\*.cs" Link="Features\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Dispatch\*.cs" Link="Dispatch\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Pipeline\*.cs" Link="Pipeline\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Notification\*.cs" Link="Notification\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\Tracing\*.cs" Link="Tracing\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Davish.JustBdd.XunitV3" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sendr\Sendr.csproj" />
    <ProjectReference Include="..\..\src\Sendr.Shared\Sendr.Shared.csproj" />
  </ItemGroup>

</Project>
