<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Davish.Sendr</PackageId>
    <AssemblyName>Davish.Sendr</AssemblyName>
    <Version>3.6.0</Version>
    <Description>A free, lightweight mediator for .NET — request/response dispatching and notification publishing with a decorator pipeline.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sendr.Abstractions\Sendr.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.0, )" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- ActivitySource ships in the net10.0 BCL; netstandard2.0 needs the package. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="[10.0.0, )" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTests" />
  </ItemGroup>
  
</Project>
